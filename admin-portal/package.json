{
  "name": "admin-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean:build": "node -e \"const fs=require('fs');fs.rmSync('.next',{recursive:true,force:true})\"",
    "clean:dev": "node -e \"const fs=require('fs');fs.rmSync('.next-dev',{recursive:true,force:true})\"",
    "dev": "set NEXT_DIST_DIR=.next-dev&& next dev -p 4000",
    "dev:clean": "npm run clean:dev && set NEXT_DIST_DIR=.next-dev&& next dev -p 4000",
    "build": "npm run clean:build && next build",
    "start": "next start -p 4000",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "axios": "^1.7.2",
    "zustand": "^5.0.0",
    "react-hook-form": "^7.52.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
