enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  CANCELLED_BY_GUEST
  CANCELLED_BY_HOST
  EXPIRED
  NO_SHOW
}

enum PaymentStatus {
