  @@index([isRead])
  @@index([createdAt])
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Host payout statements Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model HostPayout {
  id             String       @id @default(cuid())
  hostId         String
  month          String       // "2026-06"
  totalRevenue   Decimal      @db.Decimal(12, 2)
  commission     Decimal      @db.Decimal(12, 2)
  refundedAmount   Decimal      @default(0) @db.Decimal(12, 2)
  netPayout        Decimal      @db.Decimal(12, 2)
  adjustmentAmount Decimal?     @db.Decimal(12, 2)
  adjustmentReason String?
  status           PayoutStatus @default(PENDING)
  paidAt           DateTime?
  notes            String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  host User @relation(fields: [hostId], references: [id])

  @@unique([hostId, month])
  @@index([hostId])
  @@index([status])
}



