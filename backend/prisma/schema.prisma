// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Models Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String?
  displayName   String?
  phone         String?
  avatar        String?
  birthDate     DateTime? @db.Date
  nationality   String   @default("ViÃ¡Â»â€¡t Nam")
  gender        String?
  address       String?
  role          Role     @default(GUEST)
  emailVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  properties           Property[]
  bookings             Booking[]
  reviews              Review[]
  verificationTokens   VerificationToken[]
  notifications        Notification[]
  promotionRedemptions PromotionRedemption[]
  auditLogs            AuditLog[]
  hostPromotions       Promotion[]                  @relation("HostPromotions")
  listingApprovalReviews ListingApprovalReview[]

  // Operator relations
  operatorAssignments  OperatorProvinceAssignment[] @relation("OperatorAssignments")
  assignedByMe         OperatorProvinceAssignment[] @relation("AssignedByUser")
  assignedTasks        OperatorTask[]               @relation("TaskAssignee")
  createdTasks         OperatorTask[]               @relation("TaskAssigner")
  hostApprovalRequests HostApprovalRequest[]        @relation("ApplicantUser")
  reviewedApprovals    HostApprovalRequest[]        @relation("ReviewerUser")
  disputesAsHost       Dispute[]                    @relation("DisputeHost")
  disputesAsGuest      Dispute[]                    @relation("DisputeGuest")
  resolvedDisputes     Dispute[]                    @relation("DisputeResolver")
  createdByAdmin       User?                        @relation("CreatedByAdmin", fields: [createdById], references: [id])
  createdById          String?
  createdOperators     User[]                       @relation("CreatedByAdmin")
  modificationRequests BookingModification[]        @relation("ModificationRequester")
  modificationResponses BookingModification[]       @relation("ModificationResponder")
  sentMessages         BookingMessage[]
  payouts              HostPayout[]

  @@index([email])
  @@index([role])
  @@index([createdById])
}

model Province {
  id        String       @id @default(cuid())
  name      String       @unique
  code      String       @unique
  type      ProvinceType @default(TINH)
  createdAt DateTime     @default(now())

  operatorAssignments  OperatorProvinceAssignment[]
  hostApprovalRequests HostApprovalRequest[]
  tasks                OperatorTask[]
  disputes             Dispute[]

  @@index([code])
  @@index([type])
}

model OperatorProvinceAssignment {
  id         String   @id @default(cuid())
  operatorId String
  provinceId String
  assignedAt DateTime @default(now())
  assignedBy String

  operator       User     @relation("OperatorAssignments", fields: [operatorId], references: [id], onDelete: Cascade)
  province       Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  assignedByUser User     @relation("AssignedByUser", fields: [assignedBy], references: [id])

  @@unique([provinceId])
  @@index([operatorId])
  @@index([provinceId])
}

model OperatorTask {
  id           String     @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus @default(PENDING)
  assignedTo   String
  assignedBy   String
  provinceId   String?
  entityType   String?
  entityId     String?
  dueDate      DateTime?
  completedAt  DateTime?
  reportNotes  String?
  reportResult String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  assignee User      @relation("TaskAssignee", fields: [assignedTo], references: [id])
  assigner User      @relation("TaskAssigner", fields: [assignedBy], references: [id])
  province Province? @relation(fields: [provinceId], references: [id])

  @@index([assignedTo])
  @@index([assignedBy])
  @@index([status])
  @@index([provinceId])
}

model HostApprovalRequest {
  id         String         @id @default(cuid())
  userId     String
  status     ApprovalStatus @default(PENDING)
  provinceId String?
  reviewedBy String?
  reviewedAt DateTime?
  notes      String?
  documents  Json?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user     User      @relation("ApplicantUser", fields: [userId], references: [id])
  reviewer User?     @relation("ReviewerUser", fields: [reviewedBy], references: [id])
  province Province? @relation(fields: [provinceId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([provinceId])
}

model Dispute {
  id          String        @id @default(cuid())
  bookingId   String?
  hostId      String
  guestId     String
  provinceId  String?
  status      DisputeStatus @default(OPEN)
  subject     String
  description String
  resolution  String?
  resolvedBy  String?
  resolvedAt  DateTime?
  escalatedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  host     User      @relation("DisputeHost", fields: [hostId], references: [id])
  guest    User      @relation("DisputeGuest", fields: [guestId], references: [id])
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  resolver User?     @relation("DisputeResolver", fields: [resolvedBy], references: [id])
  province Province? @relation(fields: [provinceId], references: [id])

  @@index([bookingId])
  @@index([hostId])
  @@index([guestId])
  @@index([status])
  @@index([provinceId])
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  type      TokenType
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

