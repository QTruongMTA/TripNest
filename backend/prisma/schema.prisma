enum Role {
  GUEST
  HOST
  ADMIN
  OPERATOR_PROVINCE
  OPERATOR_SUB
}

enum ListingStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PropertyType {
  HOUSE
  APARTMENT
  VILLA
  HOMESTAY
  HOTEL
  RESORT
  UNIQUE
}

enum BookingMethod {
  INSTANT
  REQUEST
}

enum PetPolicy {
  ALLOWED
  ON_REQUEST
  NOT_ALLOWED
}

enum ParkingType {
